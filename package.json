{
  "name": "zandaka-api",
  "version": "1.0.0",
  "description": "Personal budgeting backend with envelope system",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .ts,.js --max-warnings=0",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "test:balances": "node --test --test-concurrency=2 -r ts-node/register tests/monetary-balance.test.ts tests/reconciliation.test.ts tests/budget.test.ts tests/settings.test.ts tests/report-snapshot.test.ts tests/payroll.test.ts tests/report-pdf.test.ts tests/transfers.test.ts",
    "test": "npm run test:balances && node -r ts-node/register tests/decimal-arithmetic.test.ts",
    "db:transfer-idempotency": "ts-node src/scripts/enable-transfer-idempotency.ts"
  },
  "keywords": [
    "budget",
    "envelope",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "decimal.js": "10.6.0",
    "express": "^4.18.2",
    "puppeteer": "^24.40.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.0.2",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
